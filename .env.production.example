# ============================================================
#  RetiScan - Plantilla de Variables de Entorno para Producción
#  Copia este archivo como .env.production y rellena los valores.
#  ⚠️  NUNCA subir .env.production a repositorios públicos.
# ============================================================

# ── Servidor ────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Dominios (públicos, con HTTPS) ──────────────────────────
LANDING_URL=https://retiscan.com
APP_URL=https://retiscan.com
API_URL=https://api.retiscan.com
PWA_URL=https://app.retiscan.com
STORAGE_URL=https://storage.retiscan.com

# ── PostgreSQL Database ─────────────────────────────────────
DB_USER=retiscan_prod
DB_HOST=db
DB_NAME=retiscan_sql
DB_PASSWORD=<GENERA_PASSWORD_SEGURA_32_CHARS>
DB_PORT=5432

# ── JWT (tokens de autenticación) ───────────────────────────
# Genera con: openssl rand -hex 32
JWT_SECRET=<GENERA_SECRET_HEX_64_CHARS>
JWT_EXPIRES_IN=24h

# ── Bcrypt (rondas de hash) ─────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── Email (Gmail SMTP) ──────────────────────────────────────
SMTP_USER=tu-email@gmail.com
SMTP_PASS=<APP_PASSWORD_GMAIL>
SMTP_FROM="RetiScan <tu-email@gmail.com>"

# ── MinIO / S3 Storage ─────────────────────────────────────
# Endpoint interno (dentro de la red Docker)
S3_ENDPOINT=http://minio:9000
# Endpoint público (acceso desde navegador con URLs firmadas)
S3_PUBLIC_ENDPOINT=https://storage.retiscan.com
S3_ACCESS_KEY=retiscan_prod
S3_SECRET_KEY=<GENERA_KEY_HEX_32_CHARS>
S3_BUCKET=retina-images
S3_REGION=us-east-1

# ── Logo para emails (Cloudinary) ───────────────────────────
LOGO_URL=https://res.cloudinary.com/tu-cloudinary/image/upload/w_100,h_100,c_fit,f_auto/logo_retiscan.png

# ── Dominio para cookies / CORS ─────────────────────────────
DOMAIN=retiscan.com
